<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/marketplaceTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabOzon"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ozon"
            android:textColor="@color/marketplace_tab_text"
            app:backgroundTint="@color/marketplace_tab_background"
            app:strokeColor="@color/marketplace_tab_background" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabWb"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="WB"
            android:textColor="@color/marketplace_tab_text"
            android:visibility="gone"
            app:backgroundTint="@color/marketplace_tab_background"
            app:strokeColor="@color/marketplace_tab_background" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_panel"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/panelToggle"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:text="@string/panel_collapse"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp"
            app:icon="@drawable/ic_panel_arrow"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@color/on_surface_variant" />

        <LinearLayout
            android:id="@+id/panelContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- Status badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_badge"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/statusIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_box"
                app:tint="@color/on_surface_muted" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/loginWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/login_warning"
                    android:textColor="@color/status_warn"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/loginNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/login_note"
                    android:textColor="@color/on_surface_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/watchConnectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/on_surface_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/watchVersionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/watch_version_unknown"
            android:textColor="@color/on_surface_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/updateBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:textColor="@color/status_warn"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Main actions: 2 columns, primary row + helper row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ordersButton"
                    style="@style/Widget.HandyPVZ.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/btn_orders"
                    app:icon="@drawable/ic_orders" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/installWatchButton"
                    style="@style/Widget.HandyPVZ.Button.Small"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_install_watch"
                    app:icon="@drawable/ic_watch" />
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/refreshButton"
                    style="@style/Widget.HandyPVZ.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/btn_refresh"
                    app:icon="@drawable/ic_refresh" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/helpButton"
                    style="@style/Widget.HandyPVZ.Button.Small"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_help"
                    app:icon="@drawable/ic_help" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/notifDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/notif_access_desc"
            android:textColor="@color/on_surface_muted"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notifButton"
            style="@style/Widget.HandyPVZ.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/notif_access_btn" />

        <TextView
            android:id="@+id/batteryDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/battery_desc"
            android:textColor="@color/on_surface_muted"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/batteryButton"
            style="@style/Widget.HandyPVZ.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/battery_btn" />

        <!-- Destructive action: quiet text button, bottom center -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutButton"
            style="@style/Widget.HandyPVZ.Button.Logout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="@string/btn_logout" />

        <!-- Support the project -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/donateButton"
            style="@style/Widget.HandyPVZ.Button.Donate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:text="@string/btn_donate"
            app:icon="@drawable/ic_heart" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
