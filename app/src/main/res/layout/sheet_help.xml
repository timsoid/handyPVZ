<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/help_title"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:fadingEdgeLength="40dp"
        android:overScrollMode="ifContentScrolls"
        android:requiresFadingEdge="vertical"
        android:scrollbarSize="3dp"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <!-- How it works -->
            <LinearLayout
                style="@style/Widget.HandyPVZ.HelpCard"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.HandyPVZ.HelpCardTitle"
                    android:text="@string/help_how_title" />

                <TextView
                    style="@style/Widget.HandyPVZ.HelpCardText"
                    android:text="@string/help_how_text" />
            </LinearLayout>

            <!-- Important: Ozon notifications (amber accent) -->
            <LinearLayout
                style="@style/Widget.HandyPVZ.HelpCard"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_help_card_warn"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.HandyPVZ.HelpCardTitle"
                    android:text="@string/help_important_title"
                    android:textColor="@color/donate_accent" />

                <TextView
                    style="@style/Widget.HandyPVZ.HelpCardText"
                    android:text="@string/help_important_text" />
            </LinearLayout>

            <!-- Privacy -->
            <LinearLayout
                style="@style/Widget.HandyPVZ.HelpCard"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.HandyPVZ.HelpCardTitle"
                    android:text="@string/help_privacy_title" />

                <TextView
                    style="@style/Widget.HandyPVZ.HelpCardText"
                    android:text="@string/help_privacy_text" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Pinned footer: always visible, no scrolling needed to reach the links -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/helpGithub"
                style="@style/Widget.HandyPVZ.Button.Small"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/help_link_github"
                app:icon="@drawable/ic_link" />

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/helpTelegram"
                style="@style/Widget.HandyPVZ.Button.Small"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/help_link_telegram"
                app:icon="@drawable/ic_chat" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/help_links_caption"
            android:textColor="@color/on_surface_muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
